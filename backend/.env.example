# Copy to backend/.env and fill in. backend/.env is git-ignored — never commit real keys.
ANTHROPIC_API_KEY=
TELOMY_TODAY=2026-10-06
TELOMY_ADMIN_KEY=change-me
# TELOMY_DB=/absolute/path/to/telomy.db

# --- Notification delivery (all optional; each channel is dormant until its vars are set) ---
# Push uses the Expo Push API and needs no key for most projects; set only if your Expo project requires it.
# EXPO_ACCESS_TOKEN=
# Email (transactional) — SMTP relay (e.g. SES/Postmark). Needs HOST + FROM at minimum.
# TELOMY_SMTP_HOST=
# TELOMY_SMTP_PORT=587
# TELOMY_SMTP_USER=
# TELOMY_SMTP_PASS=
# TELOMY_SMTP_FROM=Telomy <no-reply@telomy.health>
# SMS — India DLT-registered BSP (MSG91/Gupshup/Kaleyra). Generic JSON POST; set URL to enable (also powers real OTP).
# TELOMY_SMS_URL=
# TELOMY_SMS_KEY=
# TELOMY_SMS_SENDER=TELOMY
# WhatsApp — BSP / Meta Cloud API endpoint + token.
# TELOMY_WA_URL=
# TELOMY_WA_TOKEN=
